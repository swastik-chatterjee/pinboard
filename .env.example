# Pinboard environment variables. Copy to .env and fill in. Never commit .env.

# Prisma Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pinboard?sslmode=require"

# Long random string used to hash device tokens, edit secrets and sign moderator sessions.
# Generate: bun -e 'console.log(crypto.randomUUID()+crypto.randomUUID())'
# Changing it later invalidates all edit secrets and device limits.
TOKEN_PEPPER="replace-with-a-long-random-string"

# scrypt hash of your moderator passphrase, in the form salt:hash. See README for the command.
MOD_PASSPHRASE_HASH="salt:hash"

# Distinct devices that must report a post before auto-hide can fire (also needs the word check to match)
REPORT_THRESHOLD=3

# Where the map opens: "lat,lng"
NEXT_PUBLIC_MAP_CENTER="22.5726,88.3639"

# Name used in share text
NEXT_PUBLIC_APP_NAME="Pinboard"

# Set to 1 only if the T3 env validator (src/env.js) rejects the variables above
# SKIP_ENV_VALIDATION=1
