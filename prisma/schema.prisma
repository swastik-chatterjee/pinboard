generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostStatus {
  LIVE
  HIDDEN
  DELETED
}

model KindnessPost {
  id         String     @id @default(cuid())
  message    String
  firstName  String     @default("")
  lat        Float
  lng        Float
  gridKey    String
  deviceFp   String
  secretHash String
  status     PostStatus @default(LIVE)
  hearts     Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([lat, lng])
  @@index([createdAt])
  @@index([deviceFp, createdAt])
}

model Heart {
  id        String   @id @default(cuid())
  postId    String
  deviceId  String
  createdAt DateTime @default(now())

  @@unique([postId, deviceId])
}

model Report {
  id        String   @id @default(cuid())
  postId    String
  reason    String
  note      String   @default("")
  reporterD String
  createdAt DateTime @default(now())
  resolved  Boolean  @default(false)

  @@unique([postId, reporterD])
  @@index([postId, createdAt])
}

model RateBus {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
